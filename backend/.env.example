# Copy to .env and fill in as needed.

PORT=3147

# Must exactly match firmware/include/config.h's DEVICE_TOKEN.
DEVICE_TOKEN=YOUR_DEVICE_TOKEN_HERE

# Optional Base Sepolia ledger hook; leave false unless you have a deployed
# contract + funded key for the three vars below.
ENABLE_BLOCKCHAIN=false
BASE_SEPOLIA_RPC=https://sepolia.base.org
CONTRACT_ADDRESS=
SERVER_PRIVATE_KEY=
